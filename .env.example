# Public API and site origins
# Both brand URLs are required for separate deployments. The generic value is
# only a local fallback when a gateway serves both /api brand paths.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_URL_DIGITAL=http://localhost:3001
NEXT_PUBLIC_API_URL_PRINT=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in. Brand-specific values fall back to the generic values.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID_DIGITAL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID_PRINT=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_DIGITAL=
GOOGLE_CLIENT_SECRET_PRINT=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Keep false until the matching API deployment has an SMS provider.
NEXT_PUBLIC_PHONE_AUTH_ENABLED_DIGITAL=false
NEXT_PUBLIC_PHONE_AUTH_ENABLED_PRINT=false

# Digits only, including country code
NEXT_PUBLIC_WHATSAPP_DIGITAL=
NEXT_PUBLIC_WHATSAPP_PRINT=
