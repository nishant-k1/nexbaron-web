# Public API and site origins
# Both brand URLs are required for separate deployments. The generic value is
# only a local fallback when a gateway serves both /api brand paths.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_URL_DIGITAL=http://localhost:3001
NEXT_PUBLIC_API_URL_PRINT=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HUB_URL=http://localhost:5173

# Dedicated chat service host (division is appended to the path).
NEXT_PUBLIC_CHAT_URL=https://chat.nexbaron.com

# Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Digits only, including country code. Also used for tel:/JSON-LD phone links.
NEXT_PUBLIC_WHATSAPP_DIGITAL=
NEXT_PUBLIC_WHATSAPP_PRINT=
